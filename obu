#!/usr/bin/env python3
"""Run OBU from this checkout with its local configuration."""

from __future__ import annotations

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from obu.cli import main  # noqa: E402


raise SystemExit(main(["--config", str(ROOT / "config.toml"), *sys.argv[1:]], project_root=ROOT))
